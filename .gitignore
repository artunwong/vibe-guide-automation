# Python bytecode
__pycache__/
*.py[cod]

# Build artifacts (dist/ is a local build cache, not a download entry; see README)
build/
dist/
*.egg-info/

# Per-node worker trees: the dispatch contract now names .worktrees/<slug> by
# default, so a run that provisions them would otherwise leave the tree dirty.
.worktrees/

# Monitor run state: written by each run, changes on every execution.  Tracking
# it made the tree dirty the moment a probe ran.
/.monitor-v44/

# Local SDD working notes from development sessions; the shipped design docs
# live under docs/superpowers/ and stay tracked.
/.superpowers/

# Local environments / OS noise
.venv/
.DS_Store

# vibe session state: proposals/plans are generated per session by the vibe
# protocol and must not be tracked.
/.vibe/
